CASPIAN_CACHE_PATH=var/public-data.sqlite3
CASPIAN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CASPIAN_REQUEST_TIMEOUT_SECONDS=15
CASPIAN_WEATHER_TTL_SECONDS=1800
CASPIAN_ACTIVITY_TTL_SECONDS=21600
CASPIAN_RETRY_COOLDOWN_SECONDS=60
CASPIAN_SAILINGS_TTL_SECONDS=900
CASPIAN_TRANSIT_PATH=var/transit.sqlite3
# Explicitly enable after configuring three distinct random tokens, 24+ characters each.
CASPIAN_TRANSIT_WRITES=false
CASPIAN_ROLE_TOKENS='{}'
# Worker only. Paths, never PEM contents. REST customs = contract clearance.
CASPIAN_SIGNING_KEYS='{"logistician":"/secure/logistician.pem","carrier":"/secure/carrier.pem","customs":"/secure/clearance.pem"}'
