[Unit]
Description=Caspian Casper worker on VPS
After=network-online.target caspian-api.service
Wants=network-online.target
[Service]
User=caspian
Group=caspian
WorkingDirectory=/opt/caspian/app/backend
EnvironmentFile=/etc/caspian/backend.env
Environment=PATH=/opt/caspian/bin:/usr/bin:/bin
ExecStart=/opt/caspian/app/backend/.venv/bin/python -m app.worker
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caspian
[Install]
WantedBy=multi-user.target
