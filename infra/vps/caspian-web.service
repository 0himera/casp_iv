[Unit]
Description=Caspian Next.js on VPS
After=network-online.target caspian-api.service
[Service]
User=caspian
Group=caspian
WorkingDirectory=/opt/caspian/frontend
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3100
Environment=CASPIAN_API_URL=http://127.0.0.1:8000/api/v1
Environment=NODE_OPTIONS=--max-old-space-size=192
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/opt/caspian/node/bin/node server.js
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/caspian/frontend/.next/cache
[Install]
WantedBy=multi-user.target
