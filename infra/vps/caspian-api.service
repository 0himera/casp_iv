[Unit]
Description=Caspian API on VPS
After=network-online.target
Wants=network-online.target
[Service]
User=caspian
Group=caspian
WorkingDirectory=/opt/caspian/app/backend
EnvironmentFile=/etc/caspian/backend.env
Environment=PATH=/opt/caspian/bin:/usr/bin:/bin
ExecStart=/opt/caspian/app/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caspian
[Install]
WantedBy=multi-user.target
