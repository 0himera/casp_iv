        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "country_iso3",
          "region",
          "coordinates",
          "portwatch_id",
          "coordinate_source",
          "weather_available",
          "activity_available",
          "operator_source"
        ],
        "title": "Port"
      },
      "PortList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Port"
            },
            "type": "array",
            "title": "Items"
          },
          "catalog_checked_on": {
            "type": "string",
            "format": "date",
            "title": "Catalog Checked On"
          },
          "source_url": {
            "type": "string",
