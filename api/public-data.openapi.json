            "type": "array",
            "title": "Routes"
          },
          "assumptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Assumptions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "samples",
          "seed",
          "routes",
          "assumptions"
        ],
        "title": "PredictionResponse"
      },
      "Provenance": {
        "properties": {
          "source_id": {
            "type": "string",
            "enum": [
              "open_meteo",
              "imf_portwatch"
            ],
            "title": "Source Id"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "attribution": {
            "type": "string",
            "title": "Attribution"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "title": "Fetched At"
          },
          "source_updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Updated At"
          },
          "quality": {
            "type": "string",
            "enum": [
              "forecast",
              "estimated",
              "missing"
