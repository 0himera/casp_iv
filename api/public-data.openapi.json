{
  "openapi": "3.1.0",
  "info": {
    "title": "Caspian Flow Public Data API",
    "description": "Keyless public sources. Separate from the shipment/contract demo API.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ports": {
      "get": {
        "summary": "List Ports",
        "operationId": "list_ports_api_v1_ports_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortList"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ports/{port_id}": {
      "get": {
        "summary": "Read Port",
        "operationId": "read_port_api_v1_ports__port_id__get",
        "parameters": [
          {
            "name": "port_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Port Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Port"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/v1/ports/{port_id}/weather": {
      "get": {
        "summary": "Weather",
        "operationId": "weather_api_v1_ports__port_id__weather_get",
        "parameters": [
          {
            "name": "port_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Port Id"
            }
          },
          {
            "name": "forecast_days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 7,
              "minimum": 1,
              "default": 3,
              "title": "Forecast Days"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/v1/ports/{port_id}/activity": {
      "get": {
        "summary": "Activity",
        "operationId": "activity_api_v1_ports__port_id__activity_get",
        "parameters": [
          {
            "name": "port_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Port Id"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 90,
              "minimum": 1,
              "default": 30,
              "title": "Days"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityPoint": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "portcalls": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Portcalls"
          },
          "cargo_portcalls": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cargo Portcalls"
          },
          "tanker_portcalls": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Tanker Portcalls"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "portcalls",
          "cargo_portcalls",
          "tanker_portcalls"
        ],
        "title": "ActivityPoint"
      },
      "ActivityResponse": {
        "properties": {
          "port_id": {
            "type": "string",
            "title": "Port Id"
          },
          "portwatch_id": {
            "type": "string",
            "title": "Portwatch Id"
          },
          "window_start": {
            "type": "string",
            "format": "date",
            "title": "Window Start"
          },
          "window_end": {
            "type": "string",
            "format": "date",
            "title": "Window End"
          },
          "latest_available_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Available Date"
          },
          "unit": {
            "type": "string",
            "const": "port_calls_per_day",
            "title": "Unit",
            "default": "port_calls_per_day"
          },
          "daily": {
            "items": {
              "$ref": "#/components/schemas/ActivityPoint"
            },
            "type": "array",
            "title": "Daily"
          },
          "missing_dates": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Missing Dates"
          },
          "meta": {
            "$ref": "#/components/schemas/Provenance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "port_id",
          "portwatch_id",
          "window_start",
          "window_end",
          "latest_available_date",
          "daily",
          "missing_dates",
          "meta"
        ],
        "title": "ActivityResponse"
      },
      "Coordinates": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Coordinates"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "mode": {
            "type": "string",
            "const": "public_data",
            "title": "Mode",
            "default": "public_data"
          },
          "api_version": {
            "type": "string",
            "title": "Api Version",
            "default": "1.0.0"
          },
          "catalog_ports": {
            "type": "integer",
            "title": "Catalog Ports"
          },
          "upstream_checked": {
            "type": "boolean",
            "const": false,
            "title": "Upstream Checked",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "catalog_ports"
        ],
        "title": "Health"
      },
      "Port": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "country_iso3": {
            "type": "string",
            "title": "Country Iso3"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "coordinates": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Coordinates"
              },
              {
                "type": "null"
              }
            ]
          },
          "portwatch_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Portwatch Id"
          },
          "coordinate_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coordinate Source"
          },
          "weather_available": {
            "type": "boolean",
            "title": "Weather Available"
          },
          "activity_available": {
            "type": "boolean",
            "title": "Activity Available"
          },
          "operator_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Operator Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "country_iso3",
          "region",
          "coordinates",
          "portwatch_id",
          "coordinate_source",
          "weather_available",
          "activity_available",
          "operator_source"
        ],
        "title": "Port"
      },
      "PortList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Port"
            },
            "type": "array",
            "title": "Items"
          },
          "catalog_checked_on": {
            "type": "string",
            "format": "date",
            "title": "Catalog Checked On"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "catalog_checked_on",
          "source_url"
        ],
        "title": "PortList"
      },
      "Provenance": {
        "properties": {
          "source_id": {
            "type": "string",
            "enum": [
              "open_meteo",
              "imf_portwatch"
            ],
            "title": "Source Id"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "attribution": {
            "type": "string",
            "title": "Attribution"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "title": "Fetched At"
          },
          "source_updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Updated At"
          },
          "quality": {
            "type": "string",
            "enum": [
              "forecast",
              "estimated",
              "missing"
            ],
            "title": "Quality"
          },
          "cache_status": {
            "type": "string",
            "enum": [
              "live",
              "cached",
              "stale"
            ],
            "title": "Cache Status"
          },
          "cache_age_seconds": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cache Age Seconds"
          },
          "stale": {
            "type": "boolean",
            "title": "Stale"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "source_url",
          "attribution",
          "fetched_at",
          "source_updated_at",
          "quality",
          "cache_status",
          "cache_age_seconds",
          "stale",
          "warnings"
        ],
        "title": "Provenance"
      },
      "WeatherPoint": {
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time",
            "title": "Time"
          },
          "wind_speed_10m": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Wind Speed 10M"
          },
          "wind_gusts_10m": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Wind Gusts 10M"
          },
          "precipitation": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Precipitation"
          },
          "temperature_2m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature 2M"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "time",
          "wind_speed_10m",
          "wind_gusts_10m",
          "precipitation",
          "temperature_2m"
        ],
        "title": "WeatherPoint"
      },
      "WeatherResponse": {
        "properties": {
          "port_id": {
            "type": "string",
            "title": "Port Id"
          },
          "requested_location": {
            "$ref": "#/components/schemas/Coordinates"
          },
          "grid_location": {
            "$ref": "#/components/schemas/Coordinates"
          },
          "timezone": {
            "type": "string",
            "const": "UTC",
            "title": "Timezone",
            "default": "UTC"
          },
          "issued_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issued At"
          },
          "units": {
            "$ref": "#/components/schemas/WeatherUnits"
          },
          "hourly": {
            "items": {
              "$ref": "#/components/schemas/WeatherPoint"
            },
            "type": "array",
            "title": "Hourly"
          },
          "meta": {
            "$ref": "#/components/schemas/Provenance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "port_id",
          "requested_location",
          "grid_location",
          "issued_at",
          "units",
          "hourly",
          "meta"
        ],
        "title": "WeatherResponse"
      },
      "WeatherUnits": {
        "properties": {
          "wind_speed_10m": {
            "type": "string",
            "const": "km/h",
            "title": "Wind Speed 10M",
            "default": "km/h"
          },
          "wind_gusts_10m": {
            "type": "string",
            "const": "km/h",
            "title": "Wind Gusts 10M",
            "default": "km/h"
          },
          "precipitation": {
            "type": "string",
            "const": "mm",
            "title": "Precipitation",
            "default": "mm"
          },
          "temperature_2m": {
            "type": "string",
            "const": "°C",
            "title": "Temperature 2M",
            "default": "°C"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "WeatherUnits"
      }
    }
  }
}
