  "components": {
    "schemas": {
      "ActivityPoint": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "portcalls": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Portcalls"
          },
          "cargo_portcalls": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cargo Portcalls"
          },
          "tanker_portcalls": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Tanker Portcalls"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "portcalls",
          "cargo_portcalls",
          "tanker_portcalls"
        ],
        "title": "ActivityPoint"
      },
      "ActivityResponse": {
        "properties": {
          "port_id": {
            "type": "string",
            "title": "Port Id"
          },
          "portwatch_id": {
            "type": "string",
            "title": "Portwatch Id"
          },
          "window_start": {
            "type": "string",
            "format": "date",
            "title": "Window Start"
          },
          "window_end": {
            "type": "string",
            "format": "date",
            "title": "Window End"
          },
          "latest_available_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Available Date"
          },
          "unit": {
            "type": "string",
            "const": "port_calls_per_day",
            "title": "Unit",
            "default": "port_calls_per_day"
          },
          "daily": {
            "items": {
              "$ref": "#/components/schemas/ActivityPoint"
            },
            "type": "array",
            "title": "Daily"
          },
          "missing_dates": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Missing Dates"
          },
          "meta": {
            "$ref": "#/components/schemas/Provenance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "port_id",
          "portwatch_id",
          "window_start",
          "window_end",
          "latest_available_date",
          "daily",
          "missing_dates",
          "meta"
        ],
        "title": "ActivityResponse"
      },
      "Coordinates": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
