        "type": "object",
        "required": [
          "source_id",
          "source_url",
          "attribution",
          "fetched_at",
          "source_updated_at",
          "quality",
          "cache_status",
          "cache_age_seconds",
          "stale",
          "warnings"
        ],
        "title": "Provenance"
      },
