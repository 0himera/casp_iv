      },
      "PredictionRequest": {
        "properties": {
          "start_at": {
            "type": "string",
            "format": "date-time",
            "title": "Start At"
          },
          "routes": {
            "items": {
              "$ref": "#/components/schemas/RouteScenario"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Routes"
          },
          "samples": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 100.0,
            "title": "Samples",
            "default": 2000
          },
          "seed": {
            "type": "integer",
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 42
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start_at",
          "routes"
        ],
        "title": "PredictionRequest"
      },
      "PredictionResponse": {
        "properties": {
          "method": {
            "type": "string",
            "title": "Method",
            "default": "monte_carlo_readiness_v1"
          },
          "input_quality": {
            "type": "string",
            "title": "Input Quality",
            "default": "user_supplied_scenario"
          },
          "trained_on_history": {
            "type": "boolean",
            "title": "Trained On History",
            "default": false
          },
          "samples": {
            "type": "integer",
            "title": "Samples"
          },
          "seed": {
            "type": "integer",
            "title": "Seed"
          },
          "routes": {
            "items": {
