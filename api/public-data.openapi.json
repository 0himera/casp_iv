          "mode": {
            "type": "string",
            "const": "public_data",
            "title": "Mode",
            "default": "public_data"
          },
          "api_version": {
            "type": "string",
            "title": "Api Version",
            "default": "1.0.0"
          },
          "catalog_ports": {
            "type": "integer",
            "title": "Catalog Ports"
          },
          "upstream_checked": {
            "type": "boolean",
            "const": false,
            "title": "Upstream Checked",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "catalog_ports"
        ],
        "title": "Health"
      },
      "Port": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "country_iso3": {
            "type": "string",
            "title": "Country Iso3"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "coordinates": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Coordinates"
              },
              {
                "type": "null"
              }
            ]
          },
          "portwatch_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Portwatch Id"
          },
          "coordinate_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
