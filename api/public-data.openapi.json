          "typical_hours": {
            "type": "number",
            "maximum": 336.0,
            "minimum": 0.0,
            "title": "Typical Hours"
          },
          "maximum_hours": {
            "type": "number",
            "maximum": 336.0,
            "minimum": 0.0,
            "title": "Maximum Hours"
          }
