  "components": {
    "schemas": {
      "Role": {
        "type": "string",
        "enum": [
          "logistician",
          "carrier",
          "customs"
        ]
      },
      "Quality": {
        "type": "string",
        "enum": [
          "observed",
          "forecast",
          "synthetic",
          "stale",
          "missing"
        ]
      },
      "Action": {
        "type": "string",
        "enum": [
          "select_route",
          "replace_document",
          "attest",
          "run_scenario"
        ]
      },
      "Location": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "latitude",
          "longitude"
        ]
      },
      "Source": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "quality": {
            "$ref": "#/components/schemas/Quality"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "quality",
          "observed_at",
          "note"
        ]
      },
      "Eta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "p10": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "p50": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "p90": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "p10",
          "p50",
          "p90"
        ]
      },
      "Money": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "amount_minor": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          }
        },
        "required": [
          "amount_minor",
          "currency"
        ]
      },
      "Geometry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "LineString"
            ]
          },
          "coordinates": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "required": [
          "type",
          "coordinates"
        ]
      },
      "Route": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "modes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "rail",
                "road",
                "sea"
              ]
            }
          },
          "distance_km": {
            "type": "number",
            "minimum": 0
          },
          "geometry": {
            "$ref": "#/components/schemas/Geometry"
          },
          "geometry_kind": {
            "type": "string",
            "enum": [
              "schematic",
              "measured"
            ]
          },
          "eta": {
            "$ref": "#/components/schemas/Eta"
          },
          "miss_probability": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "cost": {
            "$ref": "#/components/schemas/Money"
          },
          "emissions_kg_co2e": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "emissions_method": {
            "type": "string"
          },
          "feasible": {
            "type": "boolean"
          },
          "infeasibility_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "capacity_status": {
            "type": "string",
            "enum": [
              "confirmed",
              "unknown",
              "synthetic"
            ]
          },
          "requires_reapproval": {
            "type": "boolean"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "ports",
          "modes",
          "distance_km",
          "geometry",
          "geometry_kind",
          "eta",
          "miss_probability",
          "cost",
          "emissions_kg_co2e",
          "emissions_method",
          "feasible",
          "infeasibility_reason",
